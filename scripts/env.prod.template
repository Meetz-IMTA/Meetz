# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Template du fichier /opt/meetz/.env.prod (à créer sur la VM)             ║
# ║                                                                            ║
# ║  1. Copier ce fichier sur la VM : scp scripts/env.prod.template           ║
# ║        deploy@<VM_IP>:/opt/meetz/.env.prod                                ║
# ║  2. Éditer les valeurs (remplacer TOUS les <...>)                         ║
# ║  3. chmod 600 /opt/meetz/.env.prod                                        ║
# ║  4. chown deploy:deploy /opt/meetz/.env.prod                              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── MariaDB (lu par le conteneur meetz-db au premier démarrage) ───────────
MYSQL_DATABASE=meetz
MYSQL_USER=meetz
MYSQL_PASSWORD=<MOT_DE_PASSE_FORT_MEETZ>
MYSQL_ROOT_PASSWORD=<MOT_DE_PASSE_ROOT_TRES_FORT>

# ── Backend Prisma (URL de connexion via le réseau Docker interne) ─────────
# Le hostname est le nom du service Docker Compose : "meetz-db"
DATABASE_URL=mysql://meetz:<MOT_DE_PASSE_FORT_MEETZ>@meetz-db:3306/meetz

# ── Backend Express ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# CORS : domaine(s) autorisé(s) à appeler l'API et le WebSocket Socket.io.
# Mettre le domaine public (ex: https://meetz.mondomaine.fr)
# ⚠ Le backend (src/index.ts) a actuellement l'origine codée en dur sur
#   "http://localhost:4200". Remplacer par process.env.CORS_ORIGIN avant
#   le premier déploiement en production.
CORS_ORIGIN=https://<TON_DOMAINE>

# ── JWT ────────────────────────────────────────────────────────────────────
# Générer des valeurs aléatoires fortes :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=<GENERER_UNE_VALEUR_ALEATOIRE_64_BYTES_HEX>
REFRESH_TOKEN_SECRET=<GENERER_UNE_AUTRE_VALEUR_ALEATOIRE_64_BYTES_HEX>

# ── Chiffrement du chat ────────────────────────────────────────────────────
# Clé existante dans apps/backend/.env (à récupérer depuis ton .env local)
CHAT_ENCRYPTION_KEY=<TA_CLE_HEX_64_CHARS>

# ── Cloudinary (stockage des images uploadées) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=<TON_CLOUD_NAME>
CLOUDINARY_API_KEY=<TA_API_KEY>
CLOUDINARY_API_SECRET=<TON_API_SECRET>

# ── Email (Mailtrap / Nodemailer) ─────────────────────────────────────────
MAILTRAP_TOKEN=<TON_TOKEN_MAILTRAP>
